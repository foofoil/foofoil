    "Music Enable Library Note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and play albums, songs, and playlists from your library, search music in Quick Open and the overview, and open Apple Music sharing links. Authorization is required on first access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览并播放资料库中的专辑、歌曲和歌单，在快速打开和总览中搜索音乐，也可直接打开 Apple Music 分享链接。首次访问需要授权。"
          }
        }
      }
    },
