    "Expose Clear History Confirmation Format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear %ld unfavorited history records and their cached content? This includes all closed items in this category, beyond the current search results. Favorited records, open foils, and original files will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除 %ld 条未收藏历史记录及其缓存内容？将清除该分类中所有已关闭的未收藏记录，不限于当前搜索结果。已收藏记录、已打开箔片和原始文件将保留。"
          }
        }
      }
    },
