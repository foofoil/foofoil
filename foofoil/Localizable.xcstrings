    "Audio Hidden Hint Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music will keep playing. Next time, press ⌘H to hide foofoil without closing the foil."
          }
        },
        "zh-Hans" : {
