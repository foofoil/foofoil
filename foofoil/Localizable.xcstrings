    "Webarchive Sandbox Tips Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to macOS sandbox security policies, opening the saved archive (.webarchive) for the first time may trigger a Gatekeeper warning.\n\nTo bypass it: Right-click the file, select \"Open\", and click \"Open\" in the confirmation dialog. It will open directly on double-click thereafter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于 macOS 系统沙盒安全策略，首次双击打开保存的网页归档文件 (.webarchive) 时可能会提示“无法验证危害”。\n\n解决方法：只需右键点击该文件，选择“打开”，在确认弹窗中点击“打开”即可，后续双击即可直接访问。"
          }
        }
      }
    },
