{
  "sourceLanguage" : "en",
  "strings" : {
    "Music List Detected Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music List Detected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到音乐列表"
          }
        }
      }
    },
    "Music List Detected Cue Message Format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A matching CUE sheet “%1$@” was found next to “%2$@”. Load it as a track list?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“%2$@”同目录发现匹配的 CUE 谱表“%1$@”。是否加载为曲目列表？"
          }
        }
      }
    },
    "Music List Detected Files Message Format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found %1$d audio files in the same folder that look like the same list as “%2$@”. Load them as a list?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同目录发现 %1$d 个疑似与“%2$@”同属一个列表的音频文件。是否加载为列表？"
          }
        }
      }
    },
    "Load List": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load List"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载列表"
          }
        }
      }
    },
    "Not Now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不"
          }
        }
      }
    },
    "No Matching Foils Format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No foils or history matching \u201c%@\u201d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配到包含\u201c%@\u201d的箔片或历史记录。"
          }
        }
      }
    },
    "Enable File Search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On File Search…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启文件搜索…"
          }
        }
      }
    },
    "Disable File Search": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off File Search"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭文件搜索"
          }
        }
      }
    },
    "File Search Needs Authorization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on file search to look through indexed files in your home folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启文件搜索后，可搜索用户目录中已建立索引的文件。"
          }
        }
      }
    },
    "File Search Authorization Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File search access expired. Turn it on again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件搜索的授权已失效，请重新开启。"
          }
        }
      }
    },
    "File Search Authorization Message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home folder is already open. Confirm to let foofoil search its indexed files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开用户目录，确认后即可搜索其中已建立索引的文件。"
          }
        }
      }
    },
    "File Search Authorization Confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启"
          }
        }
      }
    },
    "File Search Needs Home Folder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select your home folder to turn on file search."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择用户目录以开启文件搜索。"
          }
        }
      }
    },
    "File Search Authorization Failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save file search access. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存文件搜索授权，请重试。"
          }
        }
      }
    },
    "Search File Not Downloaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download this file in Finder, then try again."
