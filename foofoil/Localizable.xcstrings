          "stringUnit": {
            "state": "translated",
            "value": "Cannot create terminal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建终端"
          }
        }
      }
    },
    "Agent CLI Help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "foil — window control and terminal sessions, protocol 1\nfoil show FILE [--title TITLE] [--incognito] [--json]\nfoil update BOARD FILE [--expected-revision N] [--json]\nfoil list [--scope all] [--json]\nfoil open FILE | foil open --stdin --type markdown\nfoil reveal ID | foil hide ID | foil inspect ID\nfoil close ID --scope all [--force]\nfoil set ID opacity VALUE\nfoil terminal create [--title TITLE] [--cwd DIR] [--shell PATH]\n     [--command SCRIPT] [--env KEY=VALUE]\nfoil close BOARD [--expected-revision N] [--json]\nOptions: --request-id ID --caller NAME --session FILE --app APP\nA timeout may have committed. Retry with the same request ID and arguments within 600 seconds.\nKeep original files available. Markdown images are not loaded. User-closed boards must not be recreated automatically.\nfoil install [--directory DIR] | foil uninstall [--directory DIR]\nfoil --version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "foil — 窗口控制与终端会话，协议 1\nfoil show FILE [--title TITLE] [--incognito] [--json]\nfoil update BOARD FILE [--expected-revision N] [--json]\nfoil list [--scope all] [--json]\nfoil open FILE | foil open --stdin --type markdown\nfoil reveal ID | foil hide ID | foil inspect ID\nfoil close ID --scope all [--force]\nfoil set ID opacity VALUE\nfoil terminal create [--title TITLE] [--cwd DIR] [--shell PATH]\n     [--command SCRIPT] [--env KEY=VALUE]\nfoil close BOARD [--expected-revision N] [--json]\n选项： --request-id ID --caller NAME --session FILE --app APP\n超时可能已提交。请在 600 秒内以相同请求 ID 和参数重试。\n请保留原文件。Agent Markdown 不加载图片。用户关闭的窗口不得自动重建。\nfoil install [--directory DIR] | foil uninstall [--directory DIR]\nfoil --version"
          }
        }
      }
    },
