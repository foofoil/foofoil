#!/bin/zsh
#
# run - 构建并启动 foofoil，替代 Xcode 的 Run 按钮。
# 如果已有正在运行的实例，会先终止所有实例再重新启动。

set -euo pipefail

PROJECT="foofoil.xcodeproj"
SCHEME="foofoil"
APP_NAME="foofoil"
DESTINATION='platform=macOS'

INCLUDE_VIDEO=1
for arg in "$@"; do
    case "$arg" in
        --with-video) INCLUDE_VIDEO=1 ;;
        --without-video) INCLUDE_VIDEO=0 ;;
        *) print -u2 "Unknown option: $arg"; exit 2 ;;
    esac
done
SCRIPT_DIR="${0:A:h}"
cd "$SCRIPT_DIR"

# 构建
xcodebuild -project "$PROJECT" -scheme "$SCHEME" -configuration Debug \
    -derivedDataPath build -destination "$DESTINATION" build

APP_PATH="$SCRIPT_DIR/build/Build/Products/Debug/$APP_NAME.app"

# Debug 运行时注入兄弟仓库的开发插件；Release 分发见 ./package-dmg（内嵌插件）。
EXTENSION_ROOTS=("$SCRIPT_DIR/../hifi" "$SCRIPT_DIR/../ebook")
EXTENSION_BUNDLES=("Hi-Fi.foofoilextension" "EBook.foofoilextension")
if (( INCLUDE_VIDEO )); then
    EXTENSION_ROOTS+=("$SCRIPT_DIR/../video")
    EXTENSION_BUNDLES+=("Video.foofoilextension")
fi
DEVELOPMENT_EXTENSIONS="$SCRIPT_DIR/build/DevelopmentExtensions"

SIGN_NAME=$(codesign -dvv "$APP_PATH" 2>&1 | awk -F= '
    /^Authority=/ && value == "" { value=$2 }
    END { print value }
')
SIGN_IDENTITIES=$(security find-identity -v -p codesigning 2>/dev/null || true)
SIGN_IDENTITY=$(print -r -- "$SIGN_IDENTITIES" | awk -v name="$SIGN_NAME" '
    index($0, "\"" name "\"") > 0 && index($0, "REVOKED") == 0 && value == "" { value=$2 }
    END { print value }
')
SIGN_IDENTITY="${SIGN_IDENTITY:--}"

SIGNING_CHANGED=0
if (( ! INCLUDE_VIDEO )) && [[ -e "$APP_PATH/Contents/PlugIns/Video.foofoilextension" ]]; then
    rm -rf "$APP_PATH/Contents/PlugIns/Video.foofoilextension"
    SIGNING_CHANGED=1
fi
mkdir -p "$APP_PATH/Contents/PlugIns"
for i in {1..$#EXTENSION_ROOTS}; do
    EXT_ROOT="${EXTENSION_ROOTS[$i]}"
    BUNDLE_NAME="${EXTENSION_BUNDLES[$i]}"
    if [[ -x "$EXT_ROOT/build-plugin" ]]; then
        "$EXT_ROOT/build-plugin" "$DEVELOPMENT_EXTENSIONS" "$SIGN_IDENTITY"
        rm -rf "$APP_PATH/Contents/PlugIns/$BUNDLE_NAME"
        cp -R "$DEVELOPMENT_EXTENSIONS/$BUNDLE_NAME" "$APP_PATH/Contents/PlugIns/"
        SIGNING_CHANGED=1
    else
        print "Skipping $BUNDLE_NAME Debug plugin: $EXT_ROOT/build-plugin not found"
        # 受管理的开发插件源脚本缺失时清理旧副本，避免继续加载失效插件。
        if [[ -e "$APP_PATH/Contents/PlugIns/$BUNDLE_NAME" ]]; then
            rm -rf "$APP_PATH/Contents/PlugIns/$BUNDLE_NAME"
            SIGNING_CHANGED=1
        fi
    fi
done

if (( SIGNING_CHANGED )); then
    codesign --force --sign "$SIGN_IDENTITY" --options runtime \
        --entitlements "$SCRIPT_DIR/foofoil/foofoil.entitlements" "$APP_PATH"
    # 插件注入会改变 bundle seal；重签后刷新 LaunchServices，避免沿用构建阶段的旧登记。
    /System/Library/Frameworks/CoreServices.framework/Versions/Current/Frameworks/LaunchServices.framework/Versions/Current/Support/lsregister \
        -f -R -trusted "$APP_PATH"
fi

# Xcode 测试构建也会登记同 bundle ID 的分享扩展；清理 DerivedData 的旧登记，
# 防止 Finder 选中旧构建并向另一份应用交付文件。仅处理本应用的两个分享入口。
for SHARE_NAME in foofoilShareExtension foofoilIncognitoShareExtension; do
    SHARE_PATH="$APP_PATH/Contents/PlugIns/$SHARE_NAME.appex"
    [[ -d "$SHARE_PATH" ]] || continue
    SHARE_IDENTIFIER=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$SHARE_PATH/Contents/Info.plist")
    while IFS= read -r REGISTERED_SHARE_PATH; do
        if [[ "$REGISTERED_SHARE_PATH" == "$HOME/Library/Developer/Xcode/DerivedData/"*"/foofoil.app/Contents/PlugIns/$SHARE_NAME.appex" ]]; then
            pluginkit -r "$REGISTERED_SHARE_PATH"
        fi
    done < <(pluginkit -m -A -D -v -i "$SHARE_IDENTIFIER" | awk -F '\t' 'NF >= 4 { print $NF }')
    pluginkit -a "$SHARE_PATH"
done

# 终止所有正在运行的实例
pkill -x "$APP_NAME" 2>/dev/null || true

# 显式启动新实例，避免刚 pkill 的旧实例仍在 LaunchServices 中时，
# open 尝试向其发送 reopen 事件并返回 -600。
open -n "$APP_PATH"
